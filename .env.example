# Cloudflare R2
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Ethereum RPC
ETH_RPC_URL=

# ClickHouse
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=analytics

# Local datalake root mounted into clickhouse_local
LOCAL_DATALAKE_ROOT=/home/gharbi/Defind/data

# Relative path under LOCAL_DATALAKE_ROOT for the dataset used by clickhouse_local
LOCAL_UNISWAP_DATASET_RELATIVE_PATH=uniswap/usdc_weth_alchemy_full_c32

# Optional manual target for fetch_pool_metadata.py.
# The local bootstrap CLI infers the pool from Initialize parquet files unless
# you pass --pool-address explicitly.
POOL_ADDRESS=0x88e6A0c2dDD26FEEb64F039a2c41296FcB3f5640
